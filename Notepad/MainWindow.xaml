<Window x:Class="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="المفكرة" Height="500" Width="650" FlowDirection="RightToLeft" AllowDrop="True">
    <Grid Drop="Grid_Drop_1">
        <Button Content="فتح" Height="28" HorizontalAlignment="Left" Margin="92,2,0,0"  x:Name="Button1" VerticalAlignment="Top" Width="77" />
        <Button Content="حفظ باسم" Height="28" HorizontalAlignment="Left" Margin="174,2,0,0"  x:Name="Button2" VerticalAlignment="Top" Width="77" />
        <Button Content="مسح" Height="28" HorizontalAlignment="Left" Margin="256,2,0,0" x:Name="Button3" VerticalAlignment="Top" Width="77" />
        <TextBox Margin="2,32,2,0" Name="TextBox1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" AllowDrop="True" AcceptsReturn="True" AcceptsTab="True" AutoWordSelection="True" TextWrapping="Wrap" />
        <ComboBox x:Name="ComboBox1" HorizontalAlignment="Right" Margin="0,5,10,0" VerticalAlignment="Top" SelectedIndex="5" Width="125" FlowDirection="LeftToRight">
            <ComboBoxItem Content="ASCII"/>
            <ComboBoxItem Content="BigEndianUnicode"/>
            <ComboBoxItem Content="Unicode"/>
            <ComboBoxItem Content="UTF32"/>
            <ComboBoxItem Content="UTF7"/>
            <ComboBoxItem Content="UTF8"/>
        </ComboBox>
        <Button Content="جديد" Height="28" HorizontalAlignment="Left" Margin="10,2,0,0" x:Name="New_Click" VerticalAlignment="Top" Width="77" />
        <Button Content="الخط" Height="28" HorizontalAlignment="Left" Margin="338,2,0,0" x:Name="Font_Click" VerticalAlignment="Top" Width="77" />
    </Grid>
</Window>
